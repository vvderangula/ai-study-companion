# --- Application ---
APP_NAME=AI Study Companion
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
# Comma-separated emails that get the admin role on registration
ADMIN_EMAILS=admin@example.com

# --- Database ---
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Keep the Atlas URI in your hosting provider's secret environment variables.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=studymate

# --- Background work (thread = in-process pool; inline = synchronous, used in tests) ---
JOB_BACKEND=thread
JOB_MAX_ATTEMPTS=3

# --- Files ---
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=25

# --- AI providers (tried in order; use "fake" for offline dev without keys) ---
AI_PROVIDER_ORDER=groq,gemini
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_VISION=gemini-2.5-flash

# --- Embeddings (local ONNX model, downloaded on first use; "hash" = no model, tests only) ---
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Retrieval ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
EVIDENCE_MIN_SIMILARITY=0.62
